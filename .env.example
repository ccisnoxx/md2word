# .env.example: 单实例生产化后端配置样例，不包含真实密钥。

APP_NAME=md2word_file
APP_ENV=prod
LOG_FORMAT=json
APP_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATA_DIR=data

# Metadata store: local dev 用 file；单实例生产化建议显式切 mysql。
JOBS_REPOSITORY_BACKEND=mysql
JOBS_METADATA_DATABASE_PATH=data/metadata.sqlite3
JOBS_MYSQL_HOST=127.0.0.1
JOBS_MYSQL_PORT=3306
JOBS_MYSQL_USER=md2word
JOBS_MYSQL_PASSWORD=change-me
JOBS_MYSQL_DATABASE=md2word
JOBS_MYSQL_CHARSET=utf8mb4
JOBS_MYSQL_CONNECT_TIMEOUT_SECONDS=10

# Artifact 二进制不写入 MySQL；默认保留在本地 job 目录。
JOBS_ARTIFACT_STORAGE_BACKEND=local_file
JOBS_ARTIFACT_OBJECT_STORE_PATH=data/object_artifacts
JOBS_ARTIFACT_S3_BUCKET=
JOBS_ARTIFACT_S3_ENDPOINT_URL=
JOBS_ARTIFACT_S3_REGION=us-east-1
JOBS_ARTIFACT_S3_ACCESS_KEY_ID=
JOBS_ARTIFACT_S3_SECRET_ACCESS_KEY=
JOBS_ARTIFACT_S3_KEY_PREFIX=
JOBS_ARTIFACT_S3_PUBLIC_BASE_URL=
JOBS_ARTIFACT_S3_DOWNLOAD_MODE=redirect
JOBS_ARTIFACT_S3_PRESIGN_EXPIRES_SECONDS=3600

# Worker: in_process 最简单；external 时需同时启动 run_worker.py。
JOBS_WORKER_MODE=in_process
JOBS_WORKER_POLL_INTERVAL_SECONDS=2
JOBS_WORKER_ID=md2word-worker-1
STAGE_MESSAGE_LEASE_SECONDS=900

# Access control: open 只用于本地；生产应使用 token 或 admin。
JOBS_ACCESS_MODE=token
JOBS_ACCESS_TOKEN=change-me-jobs-token
JOBS_OPS_ACCESS_MODE=admin
ADMIN_TOKEN=change-me-admin-token

# Upload and conversion defaults.
JOBS_UPLOAD_MAX_BYTES=52428800
DEFAULT_TRANSLATION_MODE=direct
DEFAULT_TEMPLATE_ID=default
TEMPLATES_MANIFEST_PATH=template_configs/templates_manifest.yaml
TEMPLATES_STORAGE_PATH=data/config/templates
TEMPLATE_STATE_PATH=data/config/template_state.json
TERM_RULES_SEED_PATH=template_configs/term_rules.v2.yaml
TERM_RULES_STORE_PATH=data/config/term_rules_store.json
TERM_RULES_RUNTIME_YAML_PATH=data/config/runtime_subscripts_dictionary.yaml

# MinerU online PDF submission; 不使用 PDF 在线提交时可留空。
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_CALLBACK_URL=
MINERU_UID=
MINERU_CALLBACK_TOKEN=
MINERU_CALLBACK_TOKEN_QUERY_NAME=callback_token
MINERU_RESULT_HOST_ALLOWLIST=mineru.net,cdn-mineru.openxlab.org.cn
PUBLIC_DEPLOYMENT_MODE=internal

# OpenAI-compatible translation; DEFAULT_TRANSLATION_MODE=en2zh 时必须配置。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
TRANSLATION_MAX_PAGES=20
TRANSLATION_MAX_CHARS=60000
