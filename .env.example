# .env.example: 根目录运行环境变量样例，Docker P0 部署和应用配置共用这一份格式。

# 基础应用设置。
APP_NAME=md2word_file
APP_ENV=prod
LOG_FORMAT=json
APP_CORS_ORIGINS=https://md2word-api.962850.xyz,http://127.0.0.1:3000,http://localhost:3000

# Docker API 只绑定宿主机回环地址，再由宿主机 nginx 对外反代。
MD2WORD_API_BIND_HOST=127.0.0.1
MD2WORD_API_BIND_PORT=18000

# 容器内运行路径；本地 PyCharm 直跑默认使用 var。
DATA_DIR=/app/var

# MySQL metadata store。Docker Compose 内部用服务名 mysql。
MYSQL_ROOT_PASSWORD=change-me-root
JOBS_REPOSITORY_BACKEND=mysql
JOBS_METADATA_DATABASE_PATH=/app/var/metadata.sqlite3
JOBS_MYSQL_HOST=mysql
JOBS_MYSQL_PORT=3306
JOBS_MYSQL_USER=md2word
JOBS_MYSQL_PASSWORD=change-me
JOBS_MYSQL_DATABASE=md2word
JOBS_MYSQL_CHARSET=utf8mb4
JOBS_MYSQL_CONNECT_TIMEOUT_SECONDS=10

# Artifact 二进制不写入 MySQL；Docker P0 默认使用共享本地对象目录。
JOBS_ARTIFACT_STORAGE_BACKEND=local_object
JOBS_ARTIFACT_OBJECT_STORE_PATH=/app/var/object_artifacts
JOBS_ARTIFACT_S3_BUCKET=
JOBS_ARTIFACT_S3_ENDPOINT_URL=
JOBS_ARTIFACT_S3_REGION=us-east-1
JOBS_ARTIFACT_S3_ACCESS_KEY_ID=
JOBS_ARTIFACT_S3_SECRET_ACCESS_KEY=
JOBS_ARTIFACT_S3_KEY_PREFIX=
JOBS_ARTIFACT_S3_PUBLIC_BASE_URL=
JOBS_ARTIFACT_S3_DOWNLOAD_MODE=redirect
JOBS_ARTIFACT_S3_PRESIGN_EXPIRES_SECONDS=3600

# Worker。Docker P0 使用 Celery；本地直跑可改为 in_process 或 eager。
JOBS_WORKER_MODE=external
JOBS_WORKER_POLL_INTERVAL_SECONDS=2
JOBS_WORKER_ID=md2word-stage-worker-1
STAGE_MESSAGE_LEASE_SECONDS=900
DOCUMENT_JOBS_WORKER_BACKEND=celery
DOCUMENT_JOBS_CELERY_BROKER_URL=redis://redis:6379/0
DOCUMENT_JOBS_CELERY_RESULT_BACKEND=redis://redis:6379/1
DOCUMENT_JOBS_CELERY_QUEUE=document-jobs

# 访问控制。生产不要保留 change-me。
JOBS_ACCESS_MODE=token
JOBS_ACCESS_TOKEN=change-me-jobs-token
JOBS_OPS_ACCESS_MODE=admin
ADMIN_TOKEN=change-me-admin-token

# 内部账号 + JWT。
# 推荐使用 AUTH_INTERNAL_USERS_FILE，避免 PBKDF2 hash 里的 $ 被 Compose 或 shell 转义。
# 文件内容是 {"users":[...]}，password_hash 用 app.services.auth.service.hash_password() 生成。
AUTH_JWT_SECRET_KEY=change-me-jwt-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=120
AUTH_INTERNAL_USERS_FILE=deploy/auth_internal_users.json
AUTH_INTERNAL_USERS_JSON=

# 上传、解析和转换默认值。
JOBS_UPLOAD_MAX_BYTES=52428800
OSS_UPLOAD_PRESIGN_EXPIRES_SECONDS=600
OSS_DOWNLOAD_PRESIGN_EXPIRES_SECONDS=600
OSS_FILE_RETENTION_DAYS=90
PDF_UPLOAD_MAX_PAGES=200
P0_DOCUMENT_JOB_TIMEOUT_SECONDS=1200
P0_DOCUMENT_JOB_MAX_RETRIES=2
DEFAULT_TRANSLATION_MODE=direct
DEFAULT_TEMPLATE_ID=default
TEMPLATES_MANIFEST_PATH=resources/template_configs/templates_manifest.yaml
TEMPLATES_STORAGE_PATH=/app/var/config/templates
TEMPLATE_STATE_PATH=/app/var/config/template_state.json
TERM_RULES_SEED_PATH=resources/term_rules/term_rules.v2.yaml
TERM_RULES_STORE_PATH=/app/var/config/term_rules_store.json
TERM_RULES_RUNTIME_YAML_PATH=/app/var/config/runtime_subscripts_dictionary.yaml

# MinerU 在线 PDF 解析。英文 datasheet 为主时建议 en；中文 PDF 为主时改成 zh。
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_LANGUAGE=en
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
# callback 地址按 MinerU 官方文档直接填写；不要额外拼接 token 或 query 参数。
# 示例：https://md2word-api.962850.xyz/api/v1/mineru-callbacks/result
MINERU_CALLBACK_URL=
# MinerU checksum 验签使用的用户 uid；按官方文档从个人中心获取。
MINERU_UID=
MINERU_RESULT_HOST_ALLOWLIST=mineru.net,cdn-mineru.openxlab.org.cn
# 公开域名部署可保持 single_tenant_public，但 callback 鉴权依赖 checksum，不依赖额外 token。
PUBLIC_DEPLOYMENT_MODE=internal

# OpenAI-compatible 翻译；DEFAULT_TRANSLATION_MODE=en2zh 时必须配置。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-v4-flash
OPENAI_HTTP_REFERER=
OPENAI_X_TITLE=
OPENAI_ACCEPT_LANGUAGE=zh-CN
OPENAI_USER_AGENT=
TRANSLATION_PROVIDER_BACKEND=disabled
TRANSLATION_PROVIDER_TIMEOUT_SECONDS=120
TRANSLATION_PROVIDER_MAX_OUTPUT_TOKENS=12000
TRANSLATION_DEBUG_ARCHIVE_ENABLED=false
TRANSLATION_DEBUG_ARCHIVE_RETENTION_DAYS=1
TRANSLATION_MAX_PAGES=20
TRANSLATION_MAX_CHARS=60000
TRANSLATION_TERMS_PATH=resources/term_rules/translation_terms.csv
DEFAULT_TRANSLATION_TERM_VERSION_ID=en2zh@v1

# Golden Sample 回归脚本可选变量，不影响 API 启动。
GOLDEN_SAMPLE_BASE_URL=http://127.0.0.1:8000
GOLDEN_SAMPLE_USERNAME=operator
GOLDEN_SAMPLE_PASSWORD=
GOLDEN_SAMPLE_BEARER_TOKEN=
GOLDEN_SAMPLE_MANIFEST=tests/fixtures/golden_samples/manifest.yaml
GOLDEN_SAMPLE_RUNS_DIR=tests/tmp/golden_sample_runs
GOLDEN_SAMPLE_REQUEST_TIMEOUT_SECONDS=30
GOLDEN_SAMPLE_POLL_INTERVAL_SECONDS=5
GOLDEN_SAMPLE_JOB_TIMEOUT_SECONDS=1800
GOLDEN_SAMPLE_DOWNLOAD_OUTPUTS=1
GOLDEN_SAMPLE_FAIL_ON_MISSING_SAMPLES=1
